        {
          "id": "back",
          "label": "Back",
          "x": 960,
          "y": 620,
          "width": 460,
          "height": 72,
          "actions": [
            { "sound": "/shared/audio/click.wav", "volume": 0.7 },
            { "go": "main" }
          ]
