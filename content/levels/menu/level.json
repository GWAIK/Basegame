            { "sound": "/shared/audio/click.wav", "volume": 0.7 },
            { "level": "level-1" }
          ]
        },
        {
          "id": "settings",
          "label": "Settings",
          "x": 960,
          "y": 660,
          "width": 460,
          "height": 72,
          "actions": [
            { "sound": "/shared/audio/click.wav", "volume": 0.7 },
            { "go": "settings" }
          ]
        },
        {
          "id": "quit",
          "label": "Quit",
          "x": 960,
          "y": 760,
          "width": 460,
          "height": 72,
          "actions": [
            { "sound": "/shared/audio/click.wav", "volume": 0.7 },
